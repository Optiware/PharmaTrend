DB_USER=pharmatrend
DB_PASSWORD=choisir-un-mot-de-passe

# Clé de signature des jetons de connexion : une longue chaîne aléatoire, par exemple
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
